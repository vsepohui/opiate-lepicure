% layout 'opiate';


<div class="container">
	<br/>
	<div class="m-auto" style="max-width: 900px;">
		<h1><a href="/admin">Админка</a> &gt; Приглашения</h1>
		<table class="table">
		<tr>
			<th>id</th>
			<th>ctime</th>
			<th>name</th>
			<th>alias</th>
			<th>email</th>
			<th>ask</th>
		</tr>
		% for (@$invites) {
			<tr>
				<td><%= $_->{id} %></id>
				<td><%= $_->{ctime} %></td>
				<td><%= $_->{name} %></td>
				<td><%= $_->{alias} %></td>
				<td><%= $_->{email} %></td>
				<td><pre><%= $_->{ask} %></pre></td>
			</tr>
		% }
		</table>
	</div>
</div>
