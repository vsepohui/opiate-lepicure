% for my $f (@$feed) {
	<br/>
	% my $avatar = $owner->{avatar} // '/i/anonym.jpg';
	<div class="d-flex align-items-center" style="display: flow-root">
	<img src="<%= $avatar %>" style="float: left; margin-right: 7px; margin-bottom: 7px;" width="100" height="100">
	
	<div style="display: block">
	<h5 style="margin-top: 3px;">
	%= $f->{subject};
	</h5>
	[ <%= $owner->{name} %> ]<br/>
	[ <%= format_postgres_timestamp $f->{ctime} %> ]<br/>
	</div>
	</div>
	
	<p style="margin-top: 3px;">
	% my $msg = $f->{message};
	% my @l = split /\n/, $msg;
	% for (@l) {
		% $_ = html_escape $_;
		% $_ =~ s/(^|\s)(https?:\/\/[\w\d\-\.]+\S*)/$1\<a href="$2" target="_blank"\>$2\<\/a\>/g;
		% $_ =~ s/\<a href="(https:\/\/opiate\-lepicure\.ru(\/\S*"|")) target="_blank"\>/\<a href="$1\>/g;
		%== $_;
		<br/>
	% }
	</p>
	<p>
		<strong><i class="bi bi-eye"></i></strong> <%= $f->{visit_count} || 1 %>
		<a href="/<%= $owner->{alias} %>/feed/<%= $f->{id} %>" style="color: black"><strong><i class="bi bi-link-45deg"></i></strong></a>
		% if ($c->session('alias') && $c->session('alias') eq $owner->{alias}) {
			<a href="/<%= $owner->{alias} %>/feed/<%= $f->{id} %>?edit=1" style="color: black"><strong><i class="bi bi-pencil"></i></strong></a>
		% }
	</p>
	<hr/>
% }
