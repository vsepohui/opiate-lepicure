% layout 'opiate', has_feed => 1;
% title $owner->{name};

<div class="container">
	<br/>
	<div class="m-auto" style="max-width: 900px;">
	
		<form action="/<%= $owner->{alias} %>/books/add" method="POST">
			<input class="form-control form-control-lg" style="margin-top: 14px;" type="text" id="name" name="name" placeholder="Название книги" required/>
			<input class="form-control form-control-lg" style="margin-top: 14px;" type="text" id="year" name="year" placeholder="Год написания" required/>
			<input  class="btn btn-lg btn-primary w-100 py-2" style="margin-top: 14px;" type="submit" value="Создать"/>
		</form>
</div>


