% my $url = url_for;
% $url =~ s/feed\.rss//g;
<?xml version="1.0"?>
<rss version="2.0">
<channel>
   <title><%= $book->{name} %> :: <%=  $owner->{name} %> :: Opiate L'Epicure</title>
   <link>https://opiate-lepicure.ru<%= $url %></link>
   <language>ru</language>
   % if (@$list && @$list == 20) {
   <link rel="next" href="https://opiate-lepicure.ru<%= $url . '/'  %>feed.rss?page=<%= $page + 1 %>"/>
   % }
% my $n = 0;
% my $s = 0; 
% for (reverse @$list) {
	% if ($n >= ($page - 1) * 20) {
		% $s ++;
		% last if $s >= 21;
	<item>
	% my $s = $_->{title};
	% my $url = 'https://opiate-lepicure.ru' . $url . (scalar (@$list) - $n);
	<title><%= $s %></title>
	<link><%= $url %></link>
	<description>
	% my $msg = $_->{text};
	% my @l = split /\n/, $msg;
	% for (@l) {
		% $_ = html_escape $_;
		% $_ =~ s/(^|\s)(https?:\/\/[\w\.]\S*)/$1\<a href="$2"\>$2\<\/a\>/g;
		%== $_;
		<br/>
	% }
	</description>
	</item>
	% }
	% $n ++;
% }
 </channel>
</rss>
