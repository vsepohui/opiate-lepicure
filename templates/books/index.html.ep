% layout 'opiate';
% title [$book->{name}, $owner->{name}];

%= include 'include/user_header';

<div class="container">
	<div class="m-auto" style="max-width: 900px;">

		<div id="feed">
			<p>
			<h1>
				%= $book->{name};
			</h1>
			</p>
			<p>[<%= $owner->{name} %>, <%= $book->{year} %>]</p>
			<h2>Оглавление</h2>
			<ol>
				% my $num = 0;
				% for (@$list) {
					% $num ++;
					% my $title = $_->{title};
					% if ($title =~ /^\*+$/) {
						% $title = $_->{text};
						% $title =~ s/^(.*)?\n.*$/$1/mg;
						% my @w = split /\s+/, $title;
						% $title = (join ' ', grep {defined $_} ($w[0], $w[1], $w[2]) ). '...';
					% }
					<li><a href="/<%= $owner->{alias} %>/books/<%= $book->{id} %>/<%= $book->{alias} %>/<%= $num %>"><%= $title %></a></li>
				% }
			</ol>
		
	</div>
</div>


