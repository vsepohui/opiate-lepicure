% my $url = url_for;
% my $title = title;
% if ($title) {
%	$title = join ' :: ', @$title if (ref $title eq 'ARRAY');
%	$title = "$title :: Opiate L'Epicure";
% } else {
% 	$title  = 'Opiate L\'Epicure';
% }
% my @time = localtime();
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="user-scalable=no,width=device-width" />
    <meta name="description" content=""/>
    <meta name="author" content="Ivan Trunaev"/>
    <meta name="generator" content="Ivan Trunaev Hands"/>
    <title><%= $title %></title>
    <link href="/css/bootstrap.css?_=2" rel="stylesheet" />
    <link href="/css/bootstrap-icons.min.css" rel="stylesheet"/>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery-1.10.2.min.js"></script>
    <script src="/js/script.js?_=5"></script>
    <script src="/js/notify.js"></script>
% if (my $js = stash 'include_js') {
	<script src="/js/<%= $js %>"></script>
% }    
% if (my $css = stash 'include_css') {
	<link href="/css/<%= $css %>" rel="stylesheet" />
% }    
    <link href="/css/style.css?_=4" rel="stylesheet" />
% if (stash 'has_feed') {
	<link rel="alternate" type="application/rss+xml" href="<%= $url eq '/' ? '/' : $url . '/'  %>feed.rss" />
% }
% my $noty = stash ('noty') || flash ('noty');
% my $owner = stash('owner');
% my $user  = stash('user');
% flash noty => undef;
% use Encode;
% if ($noty) {
	<script>
	$(function(){
		$.notify.defaults({position:"top center"});
		% if ($noty) {
			% Encode::decode_utf8($noty);
			% for (@$noty) {
				% my $type = $_->[0];
				% my $text = $_->[1];
				% my %t = ('error' => 'error');
				$.notify("<%= $text %>", "<%= $t{$type} %>");
			% }
		% }
		});
	</script>
% }
  </head>
  <body class="d-flex flex-column h-100" style="font-family: FiraCode, monospace;">
	<div class="container">
		<header class="d-flex flex-wrap justify-content-center py-3 border-bottom">
			<a href="/" class="d-flex align-items-center me-md-auto link-body-emphasis text-decoration-none">
				<span class="fs-4"><i class="bi bi-book" style="font-size: 32px;"></i>&nbsp; Opiate L'Epicure</span>
			</a>
			<ul class="nav nav-pills text-right fs-4">
		% if ($user) {
				<div class="dropdown">
				  <button class="btn btn-lg btn-primary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
					<i class="bi bi-gear"  style="font-size: 32px;"></i>
				  </button>
				  <ul class="dropdown-menu"  style="font-size: 24px;">
					<li><a class="dropdown-item" href="/<%= $user->{alias} %>/profile">Настройки</a></li>
					% if ($is_admin) {
						<li><a class="dropdown-item" href="/admin">Админка</a></li>
					% }
					<li><a class="dropdown-item" href="#" id="logout">Выход</a></li>
				  </ul>
				</div>
		% }
			</ul>
		</header>
		<form action="/logout" id="form-logout" method="POST"/>
			%== magic;
		</form>
	</div>
	<%= content %>
	<script>
		$(function() {
			init_main();
		});
	</script>
	<footer class="container footer bottom d-flex flex-wrap justify-content-center border-top" style="margin-top: 20px;">	
		<p class="mt-3 text-center">
			&copy; Opiate L'Epicure, автор проекта <a href="/trunaev">Иван Трунаев</a>, <%= $time[5] + 1900 %><br/>
			<a href="javascript: (() => {russian_to_ruzskey() })();">Read on Ruzskey</a>
		</p>
	</footer>
	</body>
</html>
