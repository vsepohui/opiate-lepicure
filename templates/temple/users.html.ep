% layout 'opiate';


<div class="container">
	<br/>
	<div class="m-auto" style="max-width: 900px;">
		<h1><a href="/temple">Тэмпл</a> &gt; Пользователи</h1>
		<table class="table">
		<tr>
			<th>id</th>
			<th>ctime</th>
			<th>alias</th>
			<th>email</th>
			<th>name</th>
			<th></th>
		</tr>
		% for (@$users) {
			<tr>
				<td><%= $_->{id} %></td>
				<td><%= $_->{ctime} %></td>
				<td><a href="/<%= $_->{alias} %>"><%= $_->{alias} %></a></td>
				<td><%= $_->{email} %></td>
				<td><%= $_->{name} %></td>
				<td><a href="/temple/users/edit?alias=<%= $_->{alias} %>">Редактировать</a></td>
			</tr>
		% }
		</table>
	</div>
</div>
