% layout 'opiate', has_feed => 1;
% title [$owner->{name}, 'Музыка'];

%= include 'include/user_header';

<div class="container">
	<div class="m-auto" style="max-width: 900px;">
		% if ($c->session('alias') eq $owner->{alias}) {
		<form action="/<%= $owner->{alias} %>/music/add" id="form" method="POST">
			%== magic;
			<input class="form-control form-control-lg" style="margin-top: 14px; display: none;" type="text" id="html" name="html" placeholder="Код Embed share iframe с bandcamp.com" required/>
			<input  class="btn btn-lg btn-primary w-100 py-2" style="margin-top: 14px;" id="add_album" type="button" value="Добавить альбом"/>
		</form>
		% }
		
		% if(@$music) {
			<br/>
			<div class="row">
			% for (@$music) {
				<iframe class="col-md-4" style="border: 0; height: 621px;" src="https://bandcamp.com/EmbeddedPlayer/album=<%= $_->{bandcamp_id} %>/size=large/bgcol=ffffff/linkcol=a74a23/transparent=true/" seamless></iframe>
			% }
			</div>
		% }
	</div>
</div>

<script>
$(function() {
	init_add_album_button();
})
</script>
