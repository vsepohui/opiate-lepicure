% layout 'opiate', has_feed => 1;
% title $owner->{name};

% my $avatar = $owner->{avatar} // '/i/anonym.jpg';

% if (param ('edit') && $c->session('alias') eq $owner->{alias}) {
<div class="container">
<br/>
	<div class="m-auto" style="max-width: 900px;">

	% if (param ('edit') && $c->session('alias') eq $owner->{alias}) {
	<div style="float:left; display: block;">
			<img src="<%= $avatar %>" width="240px;" style="float: left; margin-right: 40px;"/><br/>

		Загрузить аватар:<br/>
		<form action="/<%= $owner->{alias} %>?avatar_upload=1" method="POST" enctype="multipart/form-data">
		<input class="btn btn-primary" type="file" accept="image/*" capture="camera" name="upload" id="upload" style="width: 240px;"><br/><br/>
		<input class="btn btn-primary" type="submit" value="Загрузить"/>
		</form>
		</div>
	% }
	<h3><%= $owner->{name} %></h3>
	
	% if (param ('edit') && $c->session('alias') eq $owner->{alias}) {
		<form method="POST">
		<textarea style="max-width: 600px;" class="form-control" placeholder="Информация о себе" id="ask" name="info" rows="8"><%= $owner->{info} %></textarea>
		<br/><br/>
		<button class="btn btn-primary py-2" class="submit">Сохранить</button>
		</form>
	% }
	<hr/>
	</div>
</div>

% } else {
	%= include 'include/user_header';
% }

<div class="container">
	<div class="m-auto" style="max-width: 900px;">

	% unless (param 'edit') {
		% if ($c->session('alias') eq $owner->{alias}) {
		<form method="POST" action="/<%= $alias %>" id="form_post">
			<input class="form-control form-control-lg" style="margin-top: 14px; display: none;" type="text" id="subject" name="subject" placeholder="Тема сообщения" spellcheck="true" required/>
			<textarea type="text" class="form-control form-control-lg" style="margin-top: 14px; display: none;" placeholder="Текст" id="message" name="message" rows="10" spellcheck="true" required></textarea>
			<input type="submit" class="btn btn-lg btn-primary w-100 py-2" style="margin-top: 14px;" id="post_button" name="post_button" value="Написать сообщение"/>
		</form>
		% }
		
		<div id="feed">
		% for my $f (@$feed) {
			<br/>
			<h4>
			%= $f->{subject};
			</h4>
			<p>[<%= format_postgres_timestamp $f->{ctime} %>]</p>
			<p>
			% my $msg = $f->{message};
			% my @l = split /\n/, $msg;
			% for (@l) {
				% $_ = html_escape $_;
				% $_ =~ s/(^|\s)(https?:\/\/[\w\.]\S*)/$1\<a href="$2" target="_blank"\>$2\<\/a\>/g;
				%== $_;
				<br/>
			% }
			</p>
			<p>
				<strong><i class="bi bi-eye"></i></strong> <%= $f->{visit_count} || 1 %>
				<a href="/<%= $owner->{alias} %>/feed/<%= $f->{id} %>" style="color: black"><strong><i class="bi bi-link-45deg"></i></strong></a>
				% if ($c->session('alias') eq $owner->{alias}) {
					<a href="/<%= $owner->{alias} %>/feed/<%= $f->{id} %>?edit=1" style="color: black"><strong><i class="bi bi-pencil"></i></strong></a>
				% }
			</p>
			<hr/>
		% }
		</div>
	% }
	</div>
</div>

<script>
$(function() {
	init_post_button_hook();
	init_ajax_feed_updater('<%= $owner->{alias} %>', <%= $feed->[0]->{id} %>);
})
</script>


