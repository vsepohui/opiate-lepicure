% layout 'opiate';
% title [$owner->{name}, $feed->{subject}];

%= include 'include/user_header';

<div class="container">


	<br/>
	<div class="m-auto" style="max-width: 900px;">
	
		% if (param 'edit') {
			% if ($c->session('alias') eq $owner->{alias}) {
				<form method="POST" action="/<%= $alias %>/feed/<%= $feed->{id} %>?edit=1" id="form_post">
					<input class="form-control form-control-lg" style="margin-top: 14px;" type="text" id="subject" name="subject" placeholder="Тема сообщения" value="<%= $feed->{subject} %>" required/>
					<textarea type="text" class="form-control form-control-lg" style="margin-top: 14px;" placeholder="Текст" id="message" name="message" rows="10" required><%= $feed->{message} %></textarea>
					<input type="submit" class="btn btn-lg btn-primary w-100 py-2" style="margin-top: 14px;" id="post_button" name="post_button" value="Сохранить"/>
				</form>			
			% }
		% } else {
		
			<div id="feed">
				<p>
				<h4>
				%= $feed->{subject};
				</h4>
				</p>
				<p>[<%= $feed->{ctime} %>]</p>
				<p>
				% my $msg = $feed->{message};
				% my @l = split /\n/, $msg;
				% for (@l) {
					% $_ =~ s/</&lt;/g;
					% $_ =~ s/>/&gt;/g;
					% $_ =~ s/(^|\s)(https?:\/\/[\w\.]\S*)/$1\<a href="$2" target="_blank"\>$2\<\/a\>/g;
					%== $_;
					<br/>
				% }
				</p>
				<p>
					<strong><i class="bi bi-eye"></i></strong> <%= $feed->{visit_count} || 1 %>
					<a href="/<%= $owner->{alias} %>/<%= $feed->{id} %>" style="color: black"><strong><i class="bi bi-link-45deg"></i></strong></a>
					% if ($c->session('alias') eq $owner->{alias}) {
						<a href="/<%= $owner->{alias} %>/<%= $feed->{id} %>?edit=1" style="color: black"><strong><i class="bi bi-pencil"></i></strong></a>
					% }
				</p>
				<hr/>
			</div>
		</div>
	 % }
</div>



