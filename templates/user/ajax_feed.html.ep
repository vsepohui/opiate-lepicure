% if (@$feed) {
	% for my $f (@$feed) {
		<p>
		<h4>
		%= $f->{subject};
		</h4>
		</p>
		<p>[<%= $f->{ctime} %>]</p>
		<p>
		% my $msg = $f->{message};
		% my @l = split /\n/, $msg;
		% for (@l) {
			% $_ =~ s/</&lt;/g;
			% $_ =~ s/>/&gt;/g;
			% $_ =~ s/(^|\s)(https?:\/\/[\w\.]\S*)/$1\<a href="$2" target="_blank"\>$2\<\/a\>/g;
			%== $_;
			<br/>
		% }
		</p>
		<p><i class="bi bi-eye"></i>&nbsp;<%= $f->{visit_count} || 1 %></p>
		<hr/>
	% }
	<script>
	$(function() {
		set_ajax_feed_case_id(<%= $feed->[0]->{id} %>);
	});
	</script>
% }
