% if (@$feed) {
	% for my $f (@$feed) {
		<p>
		<h4>
		%= $f->{subject};
		</h4>
		</p>
		<p>[<%= $f->{ctime} %>]</p>
		<p>
		% my $msg = $f->{message};
		% my @l = split /\n/, $msg;
		% for (@l) {
			% $_ =~ s/</&lt;/g;
			% $_ =~ s/>/&gt;/g;
			% $_ =~ s/(^|\s)(https?:\/\/[\w\.]\S*)/$1\<a href="$2" target="_blank"\>$2\<\/a\>/g;
			%== $_;
			<br/>
		% }
		</p>
		<p>
			<strong><i class="bi bi-eye"></i></strong> <%= $f->{visit_count} || 1 %>
			<a href="/<%= $owner->{alias} %>/<%= $f->{id} %>" style="color: black"><strong><i class="bi bi-link-45deg"></i></strong></a>
			% if ($c->session('alias') eq $owner->{alias}) {
				<a href="/<%= $owner->{alias} %>/<%= $f->{id} %>?edit=1" style="color: black"><strong><i class="bi bi-pencil"></i></strong></a>
			% }
		</p>
		<hr/>
	% }
	<script>
	$(function() {
		set_ajax_feed_case_id(<%= $feed->[0]->{id} %>);
	});
	</script>
% }
