% my $url = url_for;
% $url =~ s/\.rss//g;
<?xml version="1.0"?>
<rss version="2.0">
<channel>
   <title>Opiate L'Epicure</title>
   <link>https://opiate-lepicure.ru<%= $url %></link>
   <language>ru</language>
   % if (@$feed && @$feed == 10) {
   <link rel="next" href="https://opiate-lepicure.ru<%= $url eq '/' ? '/' : $url . '/'  %>.rss?marker=<%= $feed->[-1]->{id} %>"/>
   % }
% for (@$feed) {
	<item>
	% my $s = $_->{subject};
	% my $url = 'https://opiate-lepicure.ru/' . $alias . '/feed/' . $_->{id};
	<title><%= $s %></title>
	<link>https://opiate-lepicure.ru<%= $url %></link>
	<description>
	% my $msg = $_->{message};
	% my @l = split /\n/, $msg;
	% for (@l) {
		% $_ = html_escape $_;
		% $_ =~ s/(^|\s)(https?:\/\/[\w\.]\S*)/$1\<a href="$2"\>$2\<\/a\>/g;
		%== $_;
		<br/>
	% }
	</description>
	</item>
% }
 </channel>
</rss>
