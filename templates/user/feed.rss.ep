% my $url = url_for;
% $url =~ s/\.rss//g;
<?xml version="1.0"?>
<rss version="2.0">
<channel>
   <title>Opiate L'Epicure</title>
   <link>https://opiate-lepicure.ru<%= $url %></link>
   <language>ru</language>
   % if (@$feed && @$feed == 10) {
   <link rel="next" href="https://opiate-lepicure.ru<%= $url eq '/' ? '/' : $url . '/'  %>.rss?marker=<%= $feed->[-1]->{id} %>"/>
   % }
% for (@$feed) {
	<item>
	% my $s = $_->{subject};
	% my $url = 'https://opiate-lepicure.ru/' . $alias . '/' . $_->{id};
	<title><%= $s %></title>
	<link>https://anarchy-press.ru<%= $url %></link>
	<description>
		%== $_->{message};
	</description>
	</item>
% }
 </channel>
</rss>
