% layout 'opiate', has_feed => 1, include_js => 'photos.min.js',  include_css => 'lightbox.min.css';
% title [$owner->{name}, 'Фотографии'];

%= include 'include/user_header';

<div class="container">
	<div class="m-auto" style="max-width: 900px;">
		% if ($c->session('alias') eq $owner->{alias}) {
		<form action="/<%= $owner->{alias} %>/photos/upload" id="form" method="POST" enctype="multipart/form-data">
			%== magic;
			<input class="btn btn-primary" type="file" accept="image/*" capture="camera" name="upload" id="upload" style="display: none;">
			<button class="btn btn-lg btn-primary w-100 py-2" style="margin-top: 14px;" id="upload_photo"><i class="bi-plus-circle"></i> Загрузить</button>
		</form>
		% }

		<div class="grid row">
		% for (@$photos) {
			<div class="grid-item col-md-4" style="padding-top: 20px;">
				<a href="<%= $_->{path} %>" data-lightbox="roadtrip">
					<img src="<%= $_->{path} %>" style="max-width: 100%;"/>
				</a>
			</div>
		% }
		</div>


	</div>
</div>


<script>
$(function() {
	init_photos();
})
</script>


