% layout 'opiate', has_feed => 1;
% title $owner->{name};

%= include 'include/user_header';

<div class="container">
	<div class="m-auto" style="max-width: 900px;">
		<form action="/<%= $owner->{alias} %>/photos/upload" id="form" method="POST" enctype="multipart/form-data">
			<input class="btn btn-primary" type="file" accept="image/*" capture="camera" name="upload" id="upload" style="display: none;"><br/><br/>
			<input  class="btn btn-lg btn-primary w-100 py-2" style="margin-top: 14px;" id="upload_photo" type="submit" value="Загрузить"/>
		</form>
	</div>
	% for (@$photos) {
		<img src="<%= $_->{path} %>"/><br/>
	% }
</div>

<script>
$(function() {
	var mutex = 0;
	$('#upload_photo').click(function (event) {
		event.preventDefault();
		if (mutex % 2 == 1) {
			if ($('#upload').val()) {		
				var form = $('#form');
				form.submit();
			}
			return;
		}
		$('#upload').show(604);

		
		mutex += 1;		
	});
})
</script>


